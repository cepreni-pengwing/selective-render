{
  "schemaVersion": 1,
  "id": "selectiverender",
  "version": "${version}",
  "name": "Selective Render",
  "description": "Client-side block-precise render whitelist for selected world regions.",
  "authors": ["cepreni-pengwing"],
  "contributors": ["Codex"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["de.selectiverender.SelectiveRenderClient"]
  },
  "mixins": [
    "selectiverender.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.21",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": ">=0.92.2",
    "sodium": ">=0.5.8",
    "mixinextras": ">=0.3.5"
  },
  "suggests": {
    "iris": "*"
  }
}
